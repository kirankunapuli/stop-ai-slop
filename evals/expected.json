    { "pattern": "dead code", "match": ["unused", "dead", "import"] },
    { "pattern": "unverified network call", "match": ["requests", "timeout", "network", "unverified"] }
  ],
  "prose/commit-msg.txt": [
    { "pattern": "past-tense subject", "match": ["past tense", "imperative", "fixed", "subject"] },
    { "pattern": "filler and buzzwords", "match": ["filler", "robust", "important", "going forward", "filler phrase"] },
    { "pattern": "tool footer", "match": ["generated with", "footer", "attribution", "tool"] },
    { "pattern": "narration", "match": ["narrat", "refactor", "maintainable"] }
